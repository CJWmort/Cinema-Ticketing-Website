<html>
  <head>
    <title>Movie List</title>
    <link rel="stylesheet" href="/styles.css">
    <style>
      body{
        background-color: black;
        color: whitesmoke;
      }
      .container {
        display: grid;
        grid-template-columns: auto auto auto auto auto;
        justify-content: center;
        padding: 20px;
        row-gap: 20px;
      }
      .container div {
        font-size: 14px;
        text-align: left;
        margin: 0px 30px;
      }
      img {
        width: 200px;
        cursor: pointer;
      }
      img:hover{
        outline: 3px solid gold;
        transition: 0.3s;
        scale: 1.02;
      }
      p {
        width: 200px;
        height: 40px;
        word-wrap: break-word;
      }
    </style>
  </head>
  <body>
    <nav class="navbar">
        <div class="nav-left">
          <ul>
              <li><a href="/index.html">Home</a></li>
              <li><a class="active" href="/movie">Movies</a></li>
              <li>
                <form id="search" action="/movie/search-movie" method="GET">
                  <label for="search"><b>Search Movie:</b></label>
                  <input type="text" name="search" placeholder="search by title">
                  <button type="submit">Search</button>
                </form>
              </li>
          </ul>
        </div>
        <div class="nav-right">
          <!-- Check if user is currently logged in -->
          <%if (user){%>
            <ul>
                <!--Check if user is an admin-->
                <%if (user.role==="admin") {%>
                    <li><a href="/account/admin-tool">Admin Tools</a></li>
                <%}%>
                <li><a href="/review/watchlist">My WatchList</a></li>
                <li><a href="/account/profile">Profile</a></li>
                <li><a href="/account/register">New Account</a></li>
                <li><a id="logout" href="/account/logout">Logout</a></li>
                
            </ul>
            <span>Welcome, <%= user.username %></span>
          <%} else {%>
            <ul>
                <li><a href="/account/login">Login</a></li>
                <li><a href="/account/register">Register</a></li>
            </ul>
          <%}%> 
        </div>
    </nav>
    <!-- EJS conditional block: Check if there are any movie list -->
    <% if (movieList.length === 0) { %>
      <p>No movies found.</p> <!-- Message when there is no movies -->
    <% } else { %>
      <!-- EJS loop to render each movie -->
      <div class="container">
      <% movieList.forEach(movie => { %>
        <div>
          <a href="/review?movieid=<%=movie._id%>">
            <img src="/images/<%=movie.img || 'temp.png'%>" alt="<%=movie.img%>"
            onerror="this.onerror=null; this.src='/images/temp.png';">
          </a>
          <p><strong><%= !movie.title ? "No Title: N.A." : movie.title %></strong></p>  
          <%= !movie.duration ? "Duration: N.A." : movie.duration + " minutes" %><br><br>
          <%= !ratingList[movie._id] ? "No rating" : "Rating: " + ratingList[movie._id].toFixed(1) + "/10" %>
        </div>
      <% }); %>
      </div>
    <% } %>
  </body>
</html>
