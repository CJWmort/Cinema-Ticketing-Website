<html>
<head>
  <title>Movie Info</title>
  <link rel="stylesheet" href="styles.css">
  <style>
    body{
      background-color: black;
      color: whitesmoke;
    }
    #movieTitle{
      color: gold;
    }
    p{
      color: gold;
      font-size: 20px;
    }
    #details{
      padding: 0px 50px;
      margin: 0px 200px;
    }
    .container {
      display: flex; 
      width: 90%;
      gap: 0px; /* Adds space between the items */
    }

    .item {
      flex: 1; /* Makes both items grow equally to fill the available space */
    }
  </style>
</head>
<body>
  <nav>
      <ul>
          <li><a href="/index.html">Home</a></li>
          <li><a href="/movie-list">Movies</a></li>
      </ul>
  </nav>
  <%if(result){ %>
    <div id="details">
      <div id="movieTitle">
        <h2><%= result.title %></h2>
        Rating: 
      </div>
      <hr>
      <br>
      <div class="container">
        <div class="item">
          <img src="images/<%=result.img%>" alt="<%=result.img%>">
        </div>
        <div class="item">
          <p><strong>Details</strong></p>
          Cast: <%= result.cast %><br><br>
          Genre: <%= result.genre %><br><br>
          Release: <%= result.release %><br><br>
          Duration: <%= result.duration %> minutes<br><br>
          Language: <%= result.language %><br><br>
          <p><strong>Synopsis</strong></p>
          <%= result.description %><br><br>
        </div>
      </div>
    </div>      
  <% }else if(result===null){%>
    <p>Movie not found.</p>
  <%} %>
</body>
</html>
