<html>
    <head>
    <title>Create Movie</title>
    <link rel="stylesheet" href="/styles.css">
    <style>
        h2{
            color: gold;
            text-align: center;
        }
        body{
            background-color: black;
        }
        #register{
            background-color: #333;
            color: whitesmoke;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            padding: 10px 40px;
            border-radius: 10px;
            width: 40%;
        }
        #register div{
            text-align: center;
        }
        #register input{
            display: flex;
            padding: 10px;
            background-color: white;
            border: 3px solid cornflowerblue;
            border-radius: 5px;
            width: 100%;
        }
        #register button{
            font-size: 14px;
            background-color: cornflowerblue;
            color: whitesmoke;
            padding: 5px 10px;
            border-radius: 5px;
            border: none;
        }
        #register button:hover{
            transition: 0.3s;
            cursor: pointer;
            background-color: rgba(100, 148, 237, 0.689);
        }
        #error{
        color: rgb(255, 84, 84);
        }
        #success{
            color: rgb(89, 225, 89)
        }
        a{
            color: gold;
            font-weight: bold;
        }
    </style>
    </head>
    <body>
        <nav class="navbar">
            <div class="nav-left">
            <ul>
                <li><a href="/index.html">Home</a></li>
                <li><a href="/movie">Movies</a></li>
                <li>
                    <form id="search" action="/movie/search-movie" method="GET">
                        <label for="search"><b>Search Movie:</b></label>
                        <input type="text" name="search" placeholder="search by title">
                        <button type="submit">Search</button>
                    </form>
                </li>
            </ul>
            </div>
            <div class="nav-right">
            <!-- Check if user is currently logged in -->
            <%if (user){%>
                <ul>
                <%if (user.role==="admin") {%>
                    <li><a href="/account/admin-tool">Admin Tools</a></li>
                <%}%>
                    <li><a href="/review/watchlist">My WatchList</a></li>
                    <li><a href="/account/profile">Profile</a></li>
                    <li><a class="active" href="/account/register">New Account</a></li>
                    <li><a id="logout" href="/account/logout">Logout</a></li>
                </ul>
                <span>Welcome, <%= user.username %></span>
            <%} else {%>
                <ul>
                    <li><a href="/account/login">Login</a></li>
                    <li><a class="active" href="/account/register">Register</a></li>
                </ul>
            <%}%> 
            </div>
        </nav>
        <form id="register" action="/movie/movie-create" method="POST">
            <h2>Movie details</h2>
            <input type="text" name="title" placeholder="Movie title" required><br>

            <input type="text" name="cast" placeholder="Movie cast members" ><br>
            
            <input type="text" name="genre" placeholder="Movie genre" ><br>

            <input type="text" name="release" placeholder="Movie release date"><br>

            <input type="number" name="duration" placeholder="Movie duration" ><br>

            <input type="text" name="language" placeholder="Movie language" ><br>
            <!--New image have to be locally uploaded to images file to function-->
            <input type="text" name="img" placeholder="Image file (eg: example.png)" required><br>

            <textarea id="textarea" name="description" rows="4" cols="82" placeholder="Movie Synopsis"></textarea><br>
            
            <div>
                <br>
                <% if (msg != "success") {%>
                    <span id="error"><%= msg %></span>
                <% } else { %>
                    <span id="success">Success! Movie Added</span><br>
                <% } %>
                
                <button type="submit">Add Movie</button>
            </div>
            <br>
        </form>
    </body>
</html>
