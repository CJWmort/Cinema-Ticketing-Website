<html>
  <head>
    <title>Manage Movies</title>
    <link rel="stylesheet" href="/styles.css">
    <style>
      h2{
          color: gold;
          text-align: center;
      }
      body{
          background-color: black;
      }
      #profile{
          background-color: #333;
          color: whitesmoke;
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          padding: 10px 40px;
          border-radius: 10px;
          width: 40%;
      }
      #profile div{
          text-align: center;
      }
      #profile input{
          display: flex;
          padding: 10px;
          background-color: white;
          border: 3px solid cornflowerblue;
          border-radius: 5px;
          width: 100%;
      }
      #profile button{
          font-size: 14px;
          background-color: cornflowerblue;
          color: whitesmoke;
          padding: 5px 10px;
          border-radius: 5px;
          border: none;
      }
      #profile button:hover{
          transition: 0.3s;
          cursor: pointer;
          background-color: rgba(100, 148, 237, 0.689);
      }
      #error{
      color: rgb(255, 84, 84);
      }
      #success{
          color: rgb(89, 225, 89)
      }
      a{
          color: gold;
          font-weight: bold;
      }
    </style>
  </head>
  <body>
    <nav class="navbar">
        <div class="nav-left">
          <ul>
              <li><a href="/index.html">Home</a></li>
              <li><a href="/movie">Movies</a></li>
              <li>
                <form id="search" action="/movie/search-movie" method="GET">
                  <label for="search"><b>Search Movie:</b></label>
                  <input type="text" name="search" placeholder="search by title">
                  <button type="submit">Search</button>
                </form>
              </li>
          </ul>
        </div>
        <div class="nav-right">
          <!-- Check if user is currently logged in -->
          <%if (user){%>
            <ul>
                <!--Check if user is an admin-->
                <%if (user.role==="admin") {%>
                    <li><a class="active" href="/account/admin-tool">Admin Tools</a></li>
                <%}%>
                <li><a href="/booking/history">Booking History</a></li>
                <li><a href="/review/watchlist">My WatchList</a></li>
                <li><a href="/favourite">My Favourites</a></li>
                <li><a href="/account/profile">Profile</a></li>
                <li><a href="/account/register">New Account</a></li>
                <li><a id="logout" href="/account/logout">Logout</a></li>
            </ul>
            <span>Welcome, <%= user.username %></span>
          <%} else {%>
            <ul>
                <li><a href="/account/login">Login</a></li>
                <li><a href="/account/register">Register</a></li>
            </ul>
          <%}%> 
        </div>
    </nav>
<div style="max-width: 400px; margin: 50px auto; text-align: center; font-family: sans-serif; border: 1px solid #ccc; padding: 20px; border-radius: 8px;">
    <h2 style="color: #d9534f;">Security Verification</h2>
    
    <p style="color : gold">You are attempting to: <br>
       <strong><%= actionType.replace('-', ' ').toUpperCase() %></strong>
    </p>
    
    <p style="color : gold">Target: <strong><%= displayName %></strong></p>

    <hr style="margin: 20px 0; border: 0; border-top: 1px solid #eee;">

    <form action="/account/admin-confirm" method="POST">
        <input type="hidden" name="targetId" value="<%= targetId %>">
        <input type="hidden" name="actionType" value="<%= actionType %>">
        
        <div style="margin-bottom: 20px;">
            <label for="adminPassword" style="display: block; margin-bottom: 8px;">Confirm Admin Password:</label>
            <input type="password" name="adminPassword" id="adminPassword" required autofocus 
                   style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;" placeholder="enter admin password">
        </div>

        <button type="submit" style="background-color: #d9534f; color: white; border: none; padding: 10px 20px; border-radius: 4px; cursor: pointer; width: 100%;">
            Authorize Action
        </button>
        
        <div style="margin-top: 15px;">
            <a href="javascript:history.back()" style="color: #666; text-decoration: none; font-size: 14px;">Cancel and Go Back</a>
        </div>
    </form>
</div>

        <br>
  </body>
</html>
