<html>
  <head>
    <title>My Profile</title>
    <link rel="stylesheet" href="/styles.css">
    <style>
      main{
        margin: 10px auto;
        justify-content: center;
        width: 50%;
      }
      h2{
          color: gold;
          text-align: center;
      }
      body{
          background-color: black;
      }
      #profilepic{
        justify-content: center;
        margin: 10px;
      }
      #profile{
          background-color: #333;
          color: whitesmoke;
          padding: 10px 40px;
          border-radius: 10px;
      }
      #profile div{
          text-align: center;
      }
      #profile input{
          display: flex;
          padding: 10px;
          background-color: white;
          border: 3px solid cornflowerblue;
          border-radius: 5px;
          width: 100%;
      }
      #profile button{
          font-size: 14px;
          background-color: cornflowerblue;
          color: whitesmoke;
          padding: 5px 10px;
          border-radius: 5px;
          border: none;
      }
      #profile button:hover{
          transition: 0.3s;
          cursor: pointer;
          background-color: rgba(100, 148, 237, 0.689);
      }
      #error{
      color: rgb(255, 84, 84);
      }
      #success{
          color: rgb(89, 225, 89)
      }
      a{
          color: gold;
          font-weight: bold;
      }
    </style>
  </head>
  <body>
    <nav class="navbar">
        <div class="nav-left">
          <ul>
              <li><a href="/index.html">Home</a></li>
              <li><a href="/movie">Movies</a></li>
              <li>
                <form id="search" action="/movie/search-movie" method="GET">
                  <label for="search"><b>Search Movie:</b></label>
                  <input type="text" name="search" placeholder="search by title">
                  <button type="submit">Search</button>
                </form>
              </li>
          </ul>
        </div>
        <div class="nav-right">
          <!-- Check if user is currently logged in -->
          <%if (user){%>
            <ul>
                <!--Check if user is an admin-->
                <%if (user.role==="admin") {%>
                    <li><a href="/account/admin-tool">Admin Tools</a></li>
                <%}%>
                <li><a href="/booking/history">Booking History</a></li>
                <li><a href="/review/watchlist">My WatchList</a></li>
                <li><a href="/favourite">My Favourites</a></li>
                <li><a class="active" href="/account/profile">Edit Profile</a></li>
                <li><a href="/account/register">New Account</a></li>
                <li><a id="logout" href="/account/logout">Logout</a></li>
            </ul>
            <span>Welcome, <%= user.username %></span>
          <%} else {%>
            <ul>
                <li><a href="/account/login">Login</a></li>
                <li><a href="/account/register">Register</a></li>
            </ul>
          <%}%> 
        </div>
    </nav>
    <main>
        <form id="profile" action="/account/profile" method="POST">
          <h2>Edit My Profile</h2>
          <div id="profilepic">
            <img src="/images/pfp/<%= user.profilepic %>" width="120" height="120"  style="border-radius:50%;"><br>
          </div>
          <label for="username">Username:</label>
          <input type="text" name="username" placeholder="Username" value="<%= user.username %>" required><br>
          
          <label for="email">Email:</label>
          <input type="email" name="email" placeholder="example@gmail.com" value="<%= user.email %>" required><br>

          <label for="bio">Bio:</label>
          <input type="text" name="bio" placeholder="Bio"<%= user.bio %> value="<%= user.bio %>"><br>

          <div>
              <br>
              <% if (msg != "success") {%>
                  <span id="error"><%= msg %></span>
              <% } else { %>
                  <span id="success">Success! Your account has been updated</span>
              <% } %>
              <br><br>
              <a href="/account/user/<%= user.id %>">My homepage</a>
              <br><br>
              <a href="change-password">Change password</a>
              <br><br>
              <a href="delete-acct">Delete account</a>
              <br><br>
              <a href="change-pfp">Change profile picture</a>
              <br><br>
              <button type="submit">Save Changes</button>
          </div>
          <br>
      </form>
    </main>
    
