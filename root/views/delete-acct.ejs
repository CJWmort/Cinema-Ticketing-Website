<html>
  <head>
    <title>Delete Account </title>
    <link rel="stylesheet" href="/styles.css">
    <style>
      h2{
          color: gold;
          text-align: center;
      }
      body{
          background-color: black;
      }
      #deleteacct{
          background-color: #333;
          color: whitesmoke;
          position: absolute;
          text-align: center;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          padding: 10px 40px;
          border-radius: 10px;
          width: 40%;
      }
      #deleteacct div{
          text-align: center;
      }
      #deleteacc input{
          display: flex;
          padding: 10px;
          background-color: white;
          border: 3px solid cornflowerblue;
          border-radius: 5px;
          width: 100%;
      }
      #deleteacc button{
          font-size: 14px;
          background-color: cornflowerblue;
          color: whitesmoke;
          padding: 5px 10px;
          border-radius: 5px;
          border: none;
      }
      #deleteacc button:hover{
          transition: 0.3s;
          cursor: pointer;
          background-color: rgba(100, 148, 237, 0.689);
      }
      #error{
          color: rgb(255, 84, 84);
      }
      #success{
          color: rgb(89, 225, 89)
      }
      a{
          color: gold;
          font-weight: bold;
      }
      #deletebtn{
          background-color: rgb(255, 84, 84);
          color: whitesmoke;
          padding: 5px 10px;
          border-radius: 5px;
          border: none;
      }
      #deletebtn:hover{
        background-color: rgb(188, 41, 41);
        transition: 0.3s;
      }
    </style>
  </head>
  <body>
    <nav class="navbar">
        <div class="nav-left">
          <ul>
              <li><a href="/index.html">Home</a></li>
              <li><a href="/movie">Movies</a></li>
              <li>
                <form id="search" action="/movie/search-movie" method="GET">
                  <label for="search"><b>Search Movie:</b></label>
                  <input type="text" name="search" placeholder="search by title">
                  <button type="submit">Search</button>
                </form>
              </li>
          </ul>
        </div>
        <div class="nav-right">
          <!-- Check if user is currently logged in -->
          <%if (user){%>
            <ul>
                <!--Check if user is an admin-->
                <%if (user.role==="admin") {%>
                    <li><a href="/account/admin-tool">Admin Tools</a></li>
                <%}%>
                <li><a href="/booking/history">Booking History</a></li>
                <li><a href="/review/watchlist">My WatchList</a></li>
                <li><a class="active" href="/account/profile">Edit Profile</a></li>
                <li><a href="/account/register">New Account</a></li>
                <li><a id="logout" href="/account/logout">Logout</a></li>
            </ul>
            <span>Welcome, <%= user.username %></span>
          <%} else {%>
            <ul>
                <li><a href="/account/login">Login</a></li>
                <li><a href="/account/register">Register</a></li>
            </ul>
          <%}%> 
        </div>
    </nav>
    <form id="deleteacct" action="/account/delete-acct" method="POST">
        <h2>Delete Account</h2>

        <p style="color: gold;">
          You are about to delete your account:<br><br>
          <b>Username: </b><%= user.username %><br>
          <b>Email: </b><%= user.email %><br>
        </p>
            
        <% if (msg) { %>
            <div id="error"><%= msg %></div>
        <% } %>
                  
        <label for="password">Enter your password:</label>
        <input type="password" id="password" name="password" required> <br><br>

        <div>
            <button id="deletebtn" type="submit">Delete My Account</button>
            <br><br>
            <a href="/account/profile">Cancel</a>
        </div>
    </form>
</body>
</html>