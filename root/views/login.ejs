<html>
    <head>
    <title>Login Account</title>
    <link rel="stylesheet" href="/styles.css">
    <style>
        h2{
            color: gold;
            text-align: center;
        }
        body{
            background-color: black;
        }
        #login{
            background-color: #333;
            color: whitesmoke;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            padding: 10px 40px;
            border-radius: 10px;
            width: 40%;
        }
        #login div{
            text-align: center;
        }
        #login input{
            display: flex;
            padding: 10px;
            background-color: white;
            border: 3px solid cornflowerblue;
            border-radius: 5px;
            width: 100%;
        }
        #login button{
            font-size: 14px;
            background-color: cornflowerblue;
            color: whitesmoke;
            padding: 5px 10px;
            border-radius: 5px;
            border: none;
        }
        #login button:hover{
            transition: 0.3s;
            cursor: pointer;
            background-color: rgba(100, 148, 237, 0.689);
        }
        #error{
            color: rgb(255, 84, 84);
        }
        #success{
            color: rgb(89, 225, 89)
        }
        a{
            color: gold;
            font-weight: bold;
        }
    </style>
    </head>
    <body>
        <nav class="navbar">
            <div class="nav-left">
                <ul>
                    <li><a href="/index.html">Home</a></li>
                    <li><a href="/movie">Movies</a></li>
                    <li>
                        <form id="search" action="/movie/search-movie" method="GET">
                            <label for="search"><b>Search Movie:</b></label>
                            <input type="text" name="search" placeholder="search by title">
                            <button type="submit">Search</button>
                        </form>
                    </li>
                </ul>
            </div>
            <div class="nav-right">
                <ul>
                    <li><a class="active" href="/account/login">Login</a></li>
                    <li><a href="/account/register">Register</a></li>
                </ul>
            </div>
        </nav>
        <form id="login" action="/account/login" method="POST">
            <h2>Log In Account</h2>
            <label for="email">Email:</label>
            <input type="email" name="email" placeholder="example@gmail.com" value="<%= email ? email : ''%>" required><br>
            
            <label for="password">Password:</label>
            <input id="password" type="password" name="password" placeholder="Password" required>
            <div>
                <br>
                <% if (msg != "success") {%>
                    <span id="error"><%= msg %></span>
                <% } else { %>
                    <span id="success">Success! Account Created</span>
                <% } %>
                <br><br>
                <button type="submit">Login</button>
                <br><br>
                Need an account? <a href="/account/register">Register here</a>
            </div>
            <br>
        </form>
    </body>
</html>
